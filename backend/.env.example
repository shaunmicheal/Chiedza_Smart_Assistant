# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DB?sslmode=require

# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Auth
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1h

# One-time initial school administrator bootstrap
BOOTSTRAP_SECRET=replace-with-a-long-random-bootstrap-secret

# OpenAI (Stage 6)
OPENAI_API_KEY=

# WhatsApp Business (Stage 7)
WHATSAPP_PROVIDER=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
